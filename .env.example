# Copy this file to .env and fill in your own values. Never commit .env.

# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox).
# The app needs the Payouts feature turned on.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Email of a sandbox personal account that receives test payouts.
PAYPAL_TEST_RECEIVER_EMAIL=

# Anthropic API key for the AI.
ANTHROPIC_API_KEY=

# Solana devnet (test network, fake money). Created by `npm run wallets`.
SOLANA_RPC_URL=https://api.devnet.solana.com
PYUSD_MINT=CXk2AMBfi3TwaEL2468s6zP8xq9NxTXjp9gjMgzeUynM
TREASURY_SECRET_KEY=
TEST_WORKER_ADDRESS=
